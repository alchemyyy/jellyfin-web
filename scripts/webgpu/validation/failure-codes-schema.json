{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jellyfin.org/schemas/webgpu-validation-failure-codes-v1.json",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "codes": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
      },
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "codes"
  ],
  "type": "object"
}
