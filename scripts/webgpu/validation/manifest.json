    },
    {
      "adapter": "python-script",
      "arguments": [
        "--check"
      ],
      "id": "downmix-reference-current",
      "tags": [
        "route:audio-worklet-stereo-48k"
      ],
      "targets": [
        "scripts/webgpu/generate_seven_point_one_downmix_reference.py"
      ],
      "timeoutSeconds": 120,
      "title": "7.1-to-stereo reference data is current"
    },
    {
      "adapter": "vite-node",
      "arguments": [
        "--check"
      ],
      "id": "dts-downmix-report-current",
      "tags": [
        "codec:dts"
      ],
      "targets": [
        "scripts/webgpu/report_dts_downmix_reference.ts"
      ],
      "timeoutSeconds": 180,
      "title": "DTS exact downmix fingerprint report"
    },
    {
      "adapter": "webpack-development",
      "id": "development-build",
      "tags": [
        "checkpoint"
      ],
      "timeoutSeconds": 1800,
      "title": "Development Webpack build"
    },
    {
      "adapter": "webpack-production",
      "id": "production-build",
      "supersedes": [
        "development-build"
      ],
      "tags": [
        "release"
      ],
      "timeoutSeconds": 2400,
      "title": "Production Webpack build"
    },
    {
      "adapter": "artifact-verifier",
      "dependsOn": [
        "production-build"
      ],
      "id": "production-codec-artifacts",
      "resultFormat": "json",
      "tags": [
        "release"
      ],
      "timeoutSeconds": 300,
      "title": "Production custom codec artifact and license verification"
    },
    {
      "adapter": "vitest",
      "id": "full-vitest",
      "supersedes": [
        "vitest-codec-contracts"
      ],
      "tags": [
        "release"
      ],
      "timeoutSeconds": 1800,
      "title": "Full Vitest suite"
    },
    {
      "adapter": "eslint",
      "id": "full-eslint",
      "tags": [
        "release"
      ],
      "timeoutSeconds": 1200,
      "title": "Full ESLint suite"
    },
    {
      "adapter": "stylelint",
      "id": "full-stylelint",
      "tags": [
        "release"
      ],
      "timeoutSeconds": 600,
      "title": "Full Stylelint suite"
    },
    {
      "adapter": "toolchain-probe",
      "arguments": [
        "--check-runtime"
      ],
      "id": "local-runtime-toolchain",
      "resultAssertions": [
        {
          "operator": "equals",
          "path": "/status",
          "value": "ready"
        }
      ],
      "resultFormat": "json",
      "tags": [
        "checkpoint"
      ],
      "timeoutSeconds": 120,
      "title": "Pinned mpv, FFmpeg, Chromium CDP, and Jellyfin runtime readiness"
    }
