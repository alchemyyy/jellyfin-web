        "static"
      ],
      "targets": [
        "scripts/webgpu/*.node-test.mjs"
      ],
      "timeoutSeconds": 600,
      "title": "Standalone Node WebGPU tool tests"
    },
    {
      "adapter": "python-script",
      "arguments": [
        "--check"
      ],
