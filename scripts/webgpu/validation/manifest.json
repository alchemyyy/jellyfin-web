  "checks": [
    {
      "adapter": "python-unittest",
      "arguments": [
        "discover",
        "-s",
        "scripts/webgpu",
        "-p",
        "*_test.py"
      ],
      "id": "python-harness-tests",
      "tags": [
        "static"
      ],
      "timeoutSeconds": 300,
      "title": "Python WebGPU harness tests"
    },
    {
      "adapter": "typescript",
      "id": "typescript-check",
      "tags": [
        "static"
      ],
      "timeoutSeconds": 600,
      "title": "TypeScript build check"
    },
    {
      "adapter": "vitest",
      "id": "vitest-codec-contracts",
      "tags": [
        "static"
      ],
      "targets": [
        "src/plugins/webGPUPlayer/custom/CustomAudioOutputPolicy.test.ts",
        "src/plugins/webGPUPlayer/custom/CustomDecodeCapabilities.test.ts",
        "src/plugins/webGPUPlayer/custom/CustomDeviceProfile.test.ts",
        "src/plugins/webGPUPlayer/custom/CustomPlaybackEligibility.test.ts",
        "src/plugins/webGPUPlayer/custom/DTSChannelLayout.test.ts",
        "src/plugins/webGPUPlayer/custom/DTSExactCapabilityProbe.test.ts",
        "src/plugins/webGPUPlayer/custom/DTSMediabunnyDemuxIntegration.test.ts",
        "src/plugins/webGPUPlayer/custom/DTSSoftwareAudioDecoder.integration.test.ts",
        "src/plugins/webGPUPlayer/custom/DTSSoftwareAudioDecoder.test.ts",
        "src/plugins/webGPUPlayer/custom/JPEG2000ExactCapabilityProbe.test.ts",
        "src/plugins/webGPUPlayer/custom/JPEG2000SoftwareVideoDecoder.test.ts",
        "src/plugins/webGPUPlayer/custom/LegacySoftwareVideoDecoder.test.ts",
        "src/plugins/webGPUPlayer/custom/LegacyVideoDecoderIntegration.test.ts",
        "src/plugins/webGPUPlayer/custom/LegacyVideoExactCapabilityProbe.test.ts",
        "src/plugins/webGPUPlayer/custom/TrueHDExactCapabilityProbe.test.ts",
        "src/plugins/webGPUPlayer/custom/TrueHDExactCapabilityRunner.integration.test.ts",
        "src/plugins/webGPUPlayer/custom/TrueHDMediabunnyDemuxIntegration.test.ts",
        "src/plugins/webGPUPlayer/custom/TrueHDSoftwareAudioDecoder.integration.test.ts",
        "src/plugins/webGPUPlayer/custom/TrueHDSoftwareAudioDecoder.test.ts"
      ],
      "timeoutSeconds": 900,
      "title": "Exact custom codec contract and integration tests"
    },
    {
      "adapter": "node-test",
      "id": "node-webgpu-tool-tests",
      "tags": [
        "static"
      ],
      "targets": [
        "scripts/webgpu/*.node-test.mjs"
      ],
      "timeoutSeconds": 600,
      "title": "Standalone Node WebGPU tool tests"
    },
    {
      "adapter": "python-script",
      "arguments": [
        "--check"
      ],
      "id": "fixture-registry-current",
      "tags": [
        "static"
      ],
      "targets": [
        "scripts/webgpu/generate_validation_fixture_registry.py"
      ],
      "timeoutSeconds": 120,
      "title": "Generated validation fixture registries are current"
    },
    {
      "adapter": "python-script",
      "arguments": [
        "--check"
      ],
      "id": "dts-fixtures-current",
      "tags": [
        "codec:dts"
      ],
      "targets": [
        "scripts/webgpu/generate_dts_capability_fixtures.py"
      ],
      "timeoutSeconds": 120,
      "title": "DTS generated exact-capability table is current"
    },
    {
      "adapter": "python-script",
      "arguments": [
        "--check"
      ],
      "id": "downmix-reference-current",
      "tags": [
        "route:audio-worklet-stereo-48k"
      ],
      "targets": [
        "scripts/webgpu/generate_seven_point_one_downmix_reference.py"
      ],
      "timeoutSeconds": 120,
      "title": "7.1-to-stereo reference data is current"
    },
    {
      "adapter": "vite-node",
      "arguments": [
        "--check"
      ],
      "id": "dts-downmix-report-current",
      "tags": [
        "codec:dts"
      ],
      "targets": [
        "scripts/webgpu/report_dts_downmix_reference.ts"
      ],
      "timeoutSeconds": 180,
      "title": "DTS exact downmix fingerprint report"
    },
    {
      "adapter": "webpack-development",
      "id": "development-build",
      "tags": [
        "checkpoint"
      ],
      "timeoutSeconds": 1800,
      "title": "Development Webpack build"
    },
    {
      "adapter": "webpack-production",
      "id": "production-build",
      "supersedes": [
        "development-build"
      ],
      "tags": [
        "release"
      ],
      "timeoutSeconds": 2400,
      "title": "Production Webpack build"
    },
    {
      "adapter": "artifact-verifier",
      "dependsOn": [
        "production-build"
      ],
      "id": "production-codec-artifacts",
      "resultFormat": "json",
      "tags": [
        "release"
      ],
      "timeoutSeconds": 300,
      "title": "Production custom codec artifact and license verification"
    },
    {
      "adapter": "vitest",
      "id": "full-vitest",
      "supersedes": [
        "vitest-codec-contracts"
      ],
      "tags": [
        "release"
      ],
      "timeoutSeconds": 1800,
      "title": "Full Vitest suite"
    },
    {
      "adapter": "eslint",
      "id": "full-eslint",
      "tags": [
        "release"
      ],
      "timeoutSeconds": 1200,
      "title": "Full ESLint suite"
    },
    {
      "adapter": "stylelint",
      "id": "full-stylelint",
      "tags": [
        "release"
      ],
      "timeoutSeconds": 600,
      "title": "Full Stylelint suite"
    },
    {
      "adapter": "toolchain-probe",
      "arguments": [
        "--check-runtime"
      ],
      "environmentArguments": [
        {
          "environment": "WEBGPU_SMOKE_DEBUG_URL",
          "option": "--debug-url"
        },
        {
          "environment": "WEBGPU_SMOKE_FRONTEND_URL",
          "option": "--frontend-url"
        }
      ],
      "id": "local-runtime-toolchain",
      "resultAssertions": [
        {
          "operator": "equals",
          "path": "/status",
          "value": "ready"
        }
      ],
      "resultFormat": "json",
      "tags": [
        "checkpoint"
      ],
      "timeoutSeconds": 120,
      "title": "Pinned mpv, FFmpeg, Chromium CDP, and Jellyfin runtime readiness"
    }
  ],
