{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subtitle-validation-plan-schema.json",
  "title": "WebGPU subtitle validation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "exerciseIds",
    "routes"
  ],
  "properties": {
    "$schema": {
      "const": "subtitle-validation-plan-schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "exerciseIds": {
      "const": [
        "directplay-negotiation",
        "visible-rendering",
        "timing-seek-pause",
        "track-switch",
        "offset",
        "style-position",
        "generation-cleanup",
        "fallback",
        "html-parity"
      ]
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sourceFormats",
        "sourceKinds",
        "delivery",
        "deliveredFormat",
        "renderer",
        "currentStatus",
        "primaryPolicy",
        "secondaryPolicy",
        "requirements",
        "requiredExerciseIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceFormats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "sourceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "embedded",
              "external"
            ]
          }
        },
        "delivery": {
          "enum": [
            "external-original",
            "external-vtt-conversion",
            "server-or-html-fallback"
          ]
        },
        "deliveredFormat": {
          "type": [
            "string",
            "null"
          ]
        },
        "renderer": {
          "enum": [
            "forced-dom-text",
            "libass-canvas",
            "libpgs-canvas",
            "none"
          ]
        },
        "currentStatus": {
          "enum": [
            "code-present-unqualified",
            "server-conversion-unqualified",
            "unsupported-custom"
          ]
        },
        "primaryPolicy": {
          "enum": [
            "qualify",
            "fallback-only"
          ]
        },
        "secondaryPolicy": {
          "enum": [
            "qualify",
            "primary-only",
            "fallback-only",
            "unresolved"
          ]
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "text-track-support",
              "specialized-renderer-runtime",
              "not-retry",
              "compatible-burn-in-policy"
            ]
          }
        },
        "requiredExerciseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  }
}
