{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jellyfin.org/schemas/webgpu-validation-fixture-registry-fragment-v1.json",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "fixtures": {
      "items": {
        "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/fixture"
      },
      "minItems": 1,
      "type": "array"
    },
    "generator": {
      "pattern": "^repo://[A-Za-z0-9_.\\-/]+\\.py$",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "generator",
    "fixtures"
  ],
  "type": "object"
}
