{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hardware-matrix-plan-schema.json",
  "title": "WebGPU hardware matrix plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "browserFamilies",
    "gpuVendors",
    "exerciseIds",
    "authorizationRoutes"
  ],
  "properties": {
    "$schema": {
      "const": "hardware-matrix-plan-schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "browserFamilies": {
      "const": [
        "chrome",
        "edge"
      ]
    },
    "gpuVendors": {
      "const": [
        "nvidia",
        "amd",
        "intel"
      ]
    },
    "exerciseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lifecycle",
          "device-loss",
          "paused-device-loss",
          "startup-ten",
          "retention-thirty"
        ]
      }
    },
    "authorizationRoutes": {
      "const": [
        "external-hdr",
        "raw-hdr",
        "external-dolby-vision",
        "raw-dolby-vision",
        "dolby-vision-profile7",
        "dolby-vision-profile7-fel"
      ]
    }
  }
}
