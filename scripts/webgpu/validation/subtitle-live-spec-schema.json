{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subtitle-live-spec-schema.json",
  "title": "WebGPU private subtitle live validation specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "subtitle-live-spec-schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "identifier": {
      "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/identifier"
    },
    "environmentName": {
      "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/environmentName"
    },
    "SHA256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "normalizedBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height",
        "tolerance"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "tolerance": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        }
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "startMicroseconds",
        "endMicroseconds",
        "beforeProbeMicroseconds",
        "activeProbeMicroseconds",
        "afterProbeMicroseconds",
        "expectedBounds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "startMicroseconds": {
          "type": "integer",
          "minimum": 0
        },
        "endMicroseconds": {
          "type": "integer",
          "minimum": 1
        },
        "beforeProbeMicroseconds": {
          "type": "integer",
          "minimum": 0
        },
        "activeProbeMicroseconds": {
          "type": "integer",
          "minimum": 0
        },
        "afterProbeMicroseconds": {
          "type": "integer",
          "minimum": 0
        },
        "normalizedTextSHA256": {
          "$ref": "#/$defs/SHA256"
        },
        "imageSHA256": {
          "$ref": "#/$defs/SHA256"
        },
        "expectedBounds": {
          "$ref": "#/$defs/normalizedBounds"
        },
        "styleAssertions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "alignment",
              "animation",
              "attached-font",
              "background",
              "color",
              "italic",
              "multiline",
              "outline",
              "position",
              "safe-area"
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "normalizedTextSHA256"
          ]
        },
        {
          "required": [
            "imageSHA256"
          ]
        }
      ]
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "streamIndex",
        "role",
        "routeId",
        "sourceFormat",
        "sourceKind",
        "expectedDeliveryMethod",
        "expectedDeliveredFormat",
        "cueAssertions",
        "offsetsMicroseconds"
      ],
      "properties": {
        "streamIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "role": {
          "enum": [
            "primary",
            "secondary"
          ]
        },
        "routeId": {
          "$ref": "#/$defs/identifier"
        },
        "sourceFormat": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "sourceKind": {
          "enum": [
            "embedded",
            "external"
          ]
        },
        "expectedDeliveryMethod": {
          "enum": [
            "External",
            "Encode",
            "Drop"
          ]
        },
        "expectedDeliveredFormat": {
          "type": [
            "string",
            "null"
          ]
        },
        "assetEnvironment": {
          "$ref": "#/$defs/environmentName"
        },
        "assetMedia": {
          "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/fixture/properties/media"
        },
        "assetProvenance": {
          "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/fixture/properties/provenance"
        },
        "cueAssertions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/cue"
          }
        },
        "offsetsMicroseconds": {
          "const": [
            -1500000,
            0,
            1500000
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "itemEnvironment",
        "mediaEnvironment",
        "licenseEnvironment",
        "licenseExpression",
        "media",
        "provenance",
        "expectedPlayMethod",
        "playerModes",
        "exerciseIds",
        "tracks",
        "failureModes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "itemEnvironment": {
          "$ref": "#/$defs/environmentName"
        },
        "mediaEnvironment": {
          "$ref": "#/$defs/environmentName"
        },
        "licenseEnvironment": {
          "$ref": "#/$defs/environmentName"
        },
        "licenseExpression": {
          "type": "string",
          "minLength": 1
        },
        "media": {
          "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/fixture/properties/media"
        },
        "provenance": {
          "$ref": "https://jellyfin.org/schemas/webgpu-validation-manifest-v1.json#/$defs/fixture/properties/provenance"
        },
        "expectedPlayMethod": {
          "enum": [
            "DirectPlay",
            "DirectStream",
            "Transcode"
          ]
        },
        "playerModes": {
          "const": [
            "html",
            "custom"
          ]
        },
        "exerciseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "failureModes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "malformed-subtitle",
              "renderer-initialization",
              "subtitle-fetch",
              "subtitle-worker",
              "unsupported-format",
              "webgpu-presentation"
            ]
          }
        }
      }
    }
  }
}
